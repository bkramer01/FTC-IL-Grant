# ---------------------------------------------------------------
# Copy to .env.local for local development (never commit real values).
# ---------------------------------------------------------------

# Postgres connection string. Locally, `npm run db:local` starts an embedded
# Postgres at this address. In production use the Supabase connection string
# (Project Settings > Database > Connection string > URI, "Session pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:54339/ftc_grant

# Set to "true" when connecting to Supabase (it requires SSL).
DATABASE_SSL=false

# Admin login. Username is always FTCAdmin.
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign session cookies. Use 32+ random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-64-random-hex-characters

# Email. "smtp" sends through Hostinger. "console" prints emails to the server
# log instead of sending (handy for local testing).
EMAIL_TRANSPORT=console
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Public base URL of the site (used in emails).
APP_URL=http://localhost:3010

# Supabase project URL and publishable key (Project Settings > API). Public values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
